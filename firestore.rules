rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }

    match /tiktok_reels/{reelId} {
      allow read, write: if true;
    }

    match /instagram_journal/{itemId} {
      allow read, write: if true;
    }

    match /waitlist_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /newsletter_subscribers/{subscriberId} {
      allow read, write: if true;
    }

    match /user_wishlists/{userId} {
      allow read, write: if true;
    }

    match /tracked_orders/{orderId} {
      allow read, write: if true;
    }

    match /product_reviews/{reviewId} {
      allow read, write: if true;
    }

    match /store_settings/{settingId} {
      allow read, write: if true;
    }

    match /activeProfile/{profileId} {
      allow read, write: if true;
    }

    match /error_logs/{logId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
