rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      allow read, write: if true;
    }

    match /tiktok_reels/{reelId} {
      allow read, write: if true;
    }

    match /instagram_journal/{itemId} {
      allow read, write: if true;
    }

    match /store_settings/{settingId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
